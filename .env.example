NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBHwgFrPhKtEteRD-ZYrMrxQ3cUgwb8QDo
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=nanryosai-2027.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=nanryosai-2027
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=nanryosai-2027.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=490638573949
NEXT_PUBLIC_FIREBASE_APP_ID=1:490638573949:web:6aa6210be3396bb4278c14
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-VTX813ECF9
NEXT_PUBLIC_FUNCTIONS_REGION=asia-northeast1

# next dev (localhost:3070) 実行時に Firebase Local Emulator Suite へ接続する場合は true
# ※ shouldConnectClientEmulator() により NODE_ENV=development かつ localhost 時のみ有効化されます。
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

# 【注意】Next.js は `npm run build` 時にも `.env.local` を `.env.production` より優先読込します。
# 開発サーバ (localhost:3070) 限定で下記キルスイッチを一時変更したい場合は、
# `.env.local` ではなく `.env.development.local` に記載して本番ビルドへの誤混入を防いでください。
# NEXT_PUBLIC_MOP_ENABLED=false
# NEXT_PUBLIC_LIVE_STATE_ENABLED=false
