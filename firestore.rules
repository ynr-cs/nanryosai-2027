rules_version = '2';

// ============================================================================
// 第25回「南陵祭2027」 Cloud Firestore セキュリティルール（初期ベースライン）
// ============================================================================
//
// 【設計原則（DECISIONS.md 準拠）】
// 1. 完全フェイルクローズド（デフォルト全拒否）:
//    初期立ち上げ段階では期限付き全開放等のテスト用ルールを一切設定せず、
//    すべてのドキュメントに対するクライアントからの読み書きを遮断する。
// 2. クライアント直接書込の原則禁止（D-003）:
//    残数カウンターや注文番号発番等の業務データ更新・排他制御は、
//    Cloud Functions（2nd Gen / Admin SDK）の単一トランザクションで実行し、
//    一般クライアントからの直接書き込みは許可しない。
// 3. 一般公開範囲と内部データの分離方針（D-003 / D-004 / D-005）:
//    今後（P-001 合意後）に個別ルールを段階的に追加する際も、
//    ログインレスで参照する一般公開用の最小範囲と業務・管理用データを厳格に分離し、
//    必要な検証（スキーマ・型・サイズ・権限制御）を満たすもののみを明示的に許可する。
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {
    // 全パスに対してクライアントからの読み取り・書き込みを完全拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
