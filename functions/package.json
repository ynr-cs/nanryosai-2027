{
  "name": "nanryosai-2027-functions",
  "version": "0.1.13",
  "private": true,
  "description": "南陵祭2027 Cloud Functions 2nd Gen (asia-northeast1 / nodejs22 / esbuild)",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=lib/index.js --external:firebase-admin --external:firebase-functions"
  },
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.5",
    "typescript": "^5.9.3"
  }
}
